{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": { "separator": "  " },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "\u001b[90m 󰀄\u001b[37m  User     ",
      "keyColor": "white",
      "format": "{user-name}@{host-name}",
      "color": { "user": "magenta", "at": "white", "host": "cyan" }
    },
    { "type": "os",       "key": "\u001b[90m 󰍹\u001b[37m  OS       ", "keyColor": "white" },
    { "type": "shell",    "key": "\u001b[90m \u001b[37m  Shell    ", "keyColor": "white", "detectVersion": false },
    { "type": "terminal", "key": "\u001b[90m \u001b[37m  Terminal ", "keyColor": "white", "detectVersion": false },
    { "type": "uptime",   "key": "\u001b[90m 󰅐\u001b[37m  Uptime   ", "keyColor": "white" },
    { "type": "board",    "key": "\u001b[90m 󰌢\u001b[37m  Device   ", "keyColor": "white" },
    { "type": "cpu",      "key": "\u001b[90m \u001b[37m  CPU      ", "keyColor": "white", "format": "{1} ({3}) @ {7}", "temp": false },
    { "type": "gpu",      "key": "\u001b[90m 󰢮\u001b[37m  GPU      ", "keyColor": "white" },
    { "type": "memory",   "key": "\u001b[90m 󰍛\u001b[37m  Memory   ", "keyColor": "white" },
    { "type": "disk",     "key": "\u001b[90m \u001b[37m  Disk     ", "keyColor": "white", "folders": "C:\\" },
    "break",
    { "type": "colors", "symbol": "circle" },
    "break"
  ]
}
